# Image for the hierarchical search stages 2 and 3 (process hierarchical_fold_search, label 'hierarchical_fold').
#
# Contains:
#   /usr/local/bin/resample_timeseries   GPU resampler / fold search, compiled here from resample_timeseries.cu
#   python3 with numpy, scipy (KD-tree clustering), threadpoolctl
# The jobs do not compile anything: they use the resample_timeseries binary of this image.
#
# The base image only has to provide nvcc (CUDA toolkit) and python3 with numpy, scipy and threadpoolctl; the
# peasoup binary in it is not used by stages 2 and 3.
#
# Build (from this directory, see build_hierarchical_fold_sif.sbatch):
#   apptainer build --fakeroot --build-arg BASE_IMAGE=<base.sif> --build-arg GIT_COMMIT=<hash> \
#       hierarchical_fold_<hash>.sif hierarchical_fold.def

Bootstrap: localimage
From: {{ BASE_IMAGE }}

%arguments
    BASE_IMAGE=/hercules/u/jijin/singularity_images/peasoup_4f0472a_scipy.sif
    GIT_COMMIT=unknown

%files
    resample_timeseries.cu /software/hierarchical_fold/resample_timeseries.cu
    build_resample_timeseries.sh /software/hierarchical_fold/build_resample_timeseries.sh

%post
    set -e
    export PATH=/usr/local/cuda/bin:$PATH
    nvcc --version | tail -1
    bash /software/hierarchical_fold/build_resample_timeseries.sh /usr/local/bin/resample_timeseries
    chmod 755 /usr/local/bin/resample_timeseries
    # checks: the binary runs (usage lists the --search mode) and the python packages of stages 2 and 3 import
    /usr/local/bin/resample_timeseries 2>&1 | grep -q -- '--search'
    python3 -c "import numpy, scipy, scipy.spatial, scipy.special, threadpoolctl; print('numpy', numpy.__version__, 'scipy', scipy.__version__)"

%labels
    Author jjiang@mpifr-bonn.mpg.de
    Description "one_ring hierarchical search stages 2-3: resample_timeseries (GPU fold search) + numpy/scipy"
    OneRingCommit {{ GIT_COMMIT }}
    BaseImage {{ BASE_IMAGE }}

%help
    Stage 2/3 image of the one_ring hierarchical search. resample_timeseries is built from
    src/hierarchical_fold/resample_timeseries.cu (one_ring commit {{ GIT_COMMIT }}) and installed in /usr/local/bin.
    The source is kept in /software/hierarchical_fold.

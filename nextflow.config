/* 
 * Dispersion Plan Definition (`dd_plan`)
 * 
 * FORMAT:
 * <coherent_dm>:<start_incoherent_dm>:<end_incoherent_dm>:<dm_step>:<tscrunch>
 *
 * Fields:
 * - coherent_dm        : Coherent dispersion measure used during recording.
 * - start_incoherent_dm: Starting DM to perform dedispersion.
 * - end_incoherent_dm  : Ending DM to perform dedispersion.
 * - dm_step            : Step size of DM trials.
 * - tscrunch           : Time-scrunching factor (averaging over time).
 *
: * The pipeline selects rows based on the `coherent_dm` and `subband_dm` values in your filterbank csv file:
 * - If only `coherent_dm` is given, rows with the matching `coherent_dm` will be selected.
 * - If both `coherent_dm` and `subband_dm` are given, `subband_dm` will be used to match rows.
 * - If no values are given, rows starting with `coherent_dm = 0` will run in parallel.
 */

// Dispersion Plan
dd_plan = [
    "134.6:134.0:135.2:0.1:1",
    "135.8:135.2:136.4:0.1:1",
    "137.0:136.4:137.6:0.1:1"
]

/*
    The two flags {nbins_low} and {nbins_high} in PulsarX below correspond to:
        "-b {nbins_low} --nbinplan 0.01 {nbins_high}"

    - 'nbins_low' is passed with '-b' and sets the default number of profile bins used by PulsarX.
    - If the spin period is greater than 0.01 s, then PulsarX uses 'nbins_high' instead.

    If you want more control over how spin periods map to profile bin numbers,
    you can define a custom nbin plan using 'custom_nbin_plan'. This will over-ride all other settings.

    Example:
        custom_nbin_plan = "-b 32 --nbinplan 0.005 64 0.01 128 1.0 256"

    This means:
        - Use 32 bins by default.
        - Use 64 bins if spin period > 0.005 s.
        - Use 128 bins if spin period > 0.01 s.
        - Use 256 bins if spin period > 1.0 s.
 */

pulsarx{
    nbins_high = 64 //Upper limit of profile bins for slow pulsars (p > 10 ms)
    nbins_low = 32  //Lower limit of profile bins for rest (p < 10 ms)
    //custom_nbin_plan = "-b 32 --nbinplan 0.005 64 0.01 128 1.0 256"
    custom_nbin_plan = null
    folding_algorithm = "render" //options are presto, dspsr or render
    nsubband = 64
    subint_length = null //Default value. Tobs/64
    template_file = "${baseDir}/include/fold_templates/meerkat_fold_lband.template"
    clfd_q_value = 2.0
    rfi_filter = ""
    threads = 15
    extra_args = null
    //avoid_folding_file = "${baseDir}/scripts/avoid_spin_period_list.csv"
    avoid_folding_file = null

}

candidate_filter {

    candy_picker {
        enable = 0
        period_tolerance = 1e-8
        dm_tolerance = 100.0
    }

    ml_candidate_scoring {
        enable = 0
        models_dir = "${baseDir}/include/ml_models"
        pics_script = "${baseDir}/scripts/pics_classifier_multiple_models.py"
    }

    calculate_post_folding_heuristics {
        enable = 0
        alpha_snr_threshold = 0.0
        script = "${baseDir}/scripts/calculate_alpha_beta_gamma_dmffdot.py"
        //-> Currently supports alpha, beta, gamma and delta.
    }
    
}
/*

If you would like to fold only certain candidates from the peasoup XML file based on any XML keys (eg: period, dm, acc, pb),
use folding.configuration option.
1. Give it a unique name.
2. You can use any number of filter blocks. Each block can have any number of parameters.
3. The keys(snr, period) should match XML entries and each value should have a min. and max.
4. Candidates are selected based on intersection within a block and union across blocks.

Example: 
configuration = [
        UNIQUE_NAME: [
            [
                // Filter Block 1: Fold everything above S/N > 9, max limit 2500 candidates per XML
                snr: [min: 9, max: 10000.0],         // FFT signal-to-noise ratio
                total_cands_limit: 2500                   // max candidates to process in this set
            ],
            [
                // Filter Block 2: Fold candidates between S/N 8 and 9, if period > 5ms
                period: [min: 0.002, max: 10.0], // in seconds
                snr: [min: 6, max: 9.0],         // FFT signal-to-noise ratio
                total_cands_limit: 2500                   // max candidates to process in this set
            ]
            
        ]
    ]
*/
folding {
    script = "${baseDir}/scripts/fold_peasoup_candidates.py"
    // Each key is a group name (e.g., "first_run") and the value is a list of configuration dictionaries.
    configuration = [
        J1807_1HM000_TB_1h_wideDM: [
            [
                snr: [min: 9.0, max: 10000.0],         // FFT signal-to-noise ratio
                total_cands_limit: 5000                   // max candidates to process in this set
            ]
        ]
    ]

}
   
kafka {
    save_search_candidate_uuid = "${baseDir}/scripts/generate_uuid_search_candidate.py"
    merged_fold_search = "${baseDir}/scripts/merge_fold_candidates_for_kafka.py"
}

/*
 * Hierarchical (two-stage) circular-orbit template bank search.
 *
 * Stage 1 is the normal peasoup template bank search configured above (typically a coarse bank split
 * into several chunks, one peasoup entry per chunk). With enable = 1 the pipeline then, for every
 * filterbank and search segment:
 *   1. groups the stage-1 XML files (all chunks and, if merge_dm_ranges = 1, all incoherent DM ranges),
 *   2. clusters the candidates in Legendre-coefficient space and keeps the local S/N peaks,
 *   3. builds a fine template bank around every peak (scripts/hierarchical_search.py cluster),
 *   4. runs peasoup again with the fine bank (stage 2) using the stage-1 arguments (plus overrides),
 *   5. merges the stage-2 chunk results into a single XML file which is then folded.
 * With enable = 1 nothing is published to 05_SEARCH / 09_FOLD_FIL / 10_FOLD_FIL_FILTER: both stages go to the
 * hierarchical trees (search_publish_dir, fold_publish_dir, filter_publish_dir), with the same layout:
 *   <search_publish_dir>/<target>/<utc>/<filstr>/<pipeline_name>/<dm_start>_<dm_end>/<cfg_name>/output.xml      stage 1
 *   <search_publish_dir>/<target>/<utc>/<filstr>/<pipeline_name>/<dm_start>_<dm_end>/<stage-1 cfg dir>/<cfg_suffix>/
 *       clustered_peaks.csv, hierarchical_summary.json, [template_bank/], ck000/output.xml, ..., merged/output.xml  stage 2
 */
hierarchical_search {
    enable = 1
    script = "${baseDir}/scripts/hierarchical_search.py"
    // Only stage-1 peasoup runs whose cfg_name matches this regular expression take part (null = all).
    stage1_cfg_regex = "60m/ck.*/hierarchical/tb_ck.*"
    // 1: combine all incoherent DM ranges of a filterbank before clustering (stage 2 then searches the union).
    merge_dm_ranges = 1
    // Publish directories used instead of 05_SEARCH / 09_FOLD_FIL / 10_FOLD_FIL_FILTER when enable = 1.
    search_publish_dir = "11_HIERARCHICAL_SEARCH"   // stage-1 and stage-2 peasoup XMLs, clustering summary, fine template bank
    fold_publish_dir   = "12_HIERARCHICAL_FOLD"   // PulsarX folds
    filter_publish_dir = "13_HIERARCHICAL_SEARCH"   // PICS / post-folding heuristics
    // Sub-directory of the stage-1 cfg directory that holds the stage-2 products (e.g. 30m/ck02/hierarchical/ck000).
    cfg_suffix = null           // the stage-1 cfg names already end in .../hierarchical: stage 2 goes to full/ck000/hierarchical/
    // The first bank chunk of every stage-1 DM range dumps the dedispersed time series (peasoup -d), one
    // PRESTO-style .dat/.inf pair per DM trial, published to <search_publish_dir>/.../<dm range>/<stage-1 cfg dir>/timeseries/;
    // stage 2 folds these series.

    // Candidate clustering in Legendre-coefficient (a_n) space
    order_highest = 15          // highest Legendre order
    f0tol_fac = 0.01           // down-weighting of the spin-frequency axis
    nominal_mismatch = null     // null: MISMATCH from the header of the stage-1 template bank
    distance_tol = 5           // clustering radius in units of sqrt(nominal_mismatch)
    min_prominence = 1          // absorb a peak into a brighter touching cluster if it rises less than this S/N above the saddle (0 = keep every local maximum)
    min_snr = 9              // optional S/N cut on stage-1 candidates before clustering
    tobs = null                 // observation length (s) for a_n and the metric; null: the segment length

    // Fine lattice around every S/N peak, generated in stage 2 (hierarchical_fold_search)
    search_halfrange_fac = 5  // half extent of the lattice in units of sqrt(nominal_mismatch)
    search_stepsize_fac = 0.5   // lattice step in units of sqrt(nominal_mismatch)
    period_min = null           // shortest spin period (s) for the metric; null: SPIN PERIOD of the stage-1 bank
    sample_n = 4000             // "sample" lattice: samples of the leading Legendre coefficients per peak before pruning
                                // (random targets: 2000 leave a covering radius of 0.30 rad at the 99 % level, 4000 give 0.25, 8000 give 0.22; step 0.19)
    clip_to_bank = 1            // 1: drop fine-grid templates outside the bank's physical region (PORB range, mass limits)
    lattice = "sample"          // "linear": lattice from the metric at the peak; "adaptive": advancing front that
                                // re-evaluates the metric layer by layer, distances measured in Legendre-coefficient space
    // Cap on the size of the stage-2 search, applied after clustering, keeping the brightest peaks.
    max_peaks = null            // e.g. 50000

    // Stage 2: the dumped time series are resampled and folded on the GPU for every fine-lattice template of every
    // peak (hierarchical_fold_search, one job per dumped DM trial of the group).
    fold {
        method = "gpu_fold"         // "gpu_fold": every fine-grid template is resampled and folded on the device (exact,
                                    //   sub-integrations only for the frequency refinement); "rotate": resample the peak
                                    //   template only and search the lattice by rotating sub-integration profiles (approximate
                                    //   for far templates, needs the nsub rule below)
        use_resampler = 1           // 1: resample the series into each peak orbit's emission frame with peasoup's GPU
                                    //    kernels (scripts/resample_timeseries.cu) before folding; 0: fold with the orbit model
        resampler_mode = "nearest"  // "nearest": peasoup's default (as stage 1, independent noise); "linear": interpolation at
                                    // the fractional index (correlates neighbouring samples: biased boxcar S/N when nbins exceeds
                                    // the samples per period); "exact": peasoup --exact_resampler path (shifted time origin)
        resampler_binary = "${baseDir}/scripts/resample_timeseries"   // prebuilt with scripts/build_resample_timeseries.sh; built in the job if absent
        nsub = 0                    // sub-integrations per segment; 0 = per peak the smallest power of two keeping the
                                    // residual phase drift inside a sub-integration below max_phase_drift_bins (99 %)
        max_phase_drift_bins = 0.5
        nsub_max = 1024
        nbins = 64                  // profile bins
        ducy_max = 0.3              // widest boxcar as a fraction of the profile
        f0_halfrange_bins = 1.5     // frequency offsets searched around each template, in Fourier bins (1/tobs); covers (with margin) the interbinning quantisation of the stage-1 frequency (each template is folded at the frequency the stage-1 FFT finds it at)
        f0_step_bins = 0.1          // about 0.5 * (narrowest pulse width in bins) / nbins
        dm_trials = 1               // nearest DM trials folded per peak
        max_rounds = 20             // iterative search: a branch whose best lies beyond edge_frac of its ball (or of
                                    // the frequency scan) is re-centred on it and searched again; a best well inside
                                    // the ball halts and goes to the refinement; after every round all branches are
                                    // clustered (distance_tol, f0tol_fac, min_prominence above), so branches of one
                                    // signal merge (1 = single round)
        edge_frac = 0.9
        drift_snr_ratio = 1.5       // a branch at a local maximum keeps drifting while a candidate at the same frequency
        drift_fdiff = 3e-3          // (within drift_fdiff, the bank's maximal Doppler shift) and DM (drift_dm_tol) is
        drift_dm_tol = 1.5          // this many times brighter: it is an alias of that signal (0 = off)
        refine_iter = 3             // local refinement of each peak's best (orbit, frequency): parabolic steps along the
                                    // metric eigen-directions, starting at half the grid step and halving every iteration;
                                    // 7 evaluations per peak and iteration, batched over the peaks of a DM trial (0 = off)
    }

    // PulsarX folding of the stage-2 candidates: same syntax as folding.configuration, but the 'snr'
    // here is the fold S/N of the stage-2 search (boxcar statistic of the aligned profile), not the FFT S/N
    // of stage 1, so it needs its own thresholds. Candidates are selected by the union of the blocks.
    folding_configuration = [
        hierarchical: [
            [
                snr: [min: 9.0, max: 10000.0],
                total_cands_limit: 1000
            ]
        ]
    ]
    // 1: also fold the stage-1 candidates (default: only the stage-2 results are folded).
    fold_stage1_candidates = 0
}



}

profiles {
   local {
    includeConfig 'configs/local.config'   
 }
   hercules {
    includeConfig 'configs/hercules.config'
  }
  ozstar {
    includeConfig 'configs/ozstar.config'
  }
  ngarrgu {
    includeConfig 'configs/ngarrgu.config'
  }
  contra {
    includeConfig 'configs/contra.config'
  }

}



